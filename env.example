# ---- Frontend: copy to .env in the project root ----
VITE_API_URL=http://127.0.0.1:8000
# true = canned data in the browser, no backend needed
VITE_DEMO_MODE=false

# ---- Backend: copy to backend/.env ----
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/
#   or MONGO_URI=memory  for a throwaway in-process database
# MONGO_DB=solsight
# CORS_ORIGINS=http://localhost:5173
